{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "card-roguelike-multiplayer",
  "main": "worker.js",
  "compatibility_date": "2026-10-20",
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,https://ljf920727.github.io,https://iliaamiri.github.io"
  }
}
